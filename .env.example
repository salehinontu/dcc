# ---- server ----
PORT=3000
PUBLIC_HOST=localhost
JWT_SECRET=dev-secret-change-me

# Embedded Postgres data directory (dev). Set DATABASE_URL to use a real Postgres.
DATA_DIR=.data
# DATABASE_URL=postgres://dji:dji@localhost:5432/dji

# ---- MQTT (dev broker runs locally; point to EMQX in production) ----
MQTT_URL=mqtt://127.0.0.1:1883
# Must include a scheme for Pilot 2: tcp://host:1883 or ssl://host:8883
MQTT_PUBLIC_HOST=tcp://localhost:1883
MQTT_USERNAME=dji-server
MQTT_PASSWORD=dji-server
MQTT_CREDENTIAL_TTL_HOURS=168

# Empty in production (same-origin); comma-separated origins for dev.
CORS_ORIGINS=http://localhost:5173


# ---- DJI Cloud API app (fill once the developer account exists) ----
DJI_APP_ID=
DJI_APP_KEY=
DJI_APP_LICENSE=
# The name Pilot 2 shows for this platform; defaults to BRAND_NAME.
# DJI_PLATFORM_NAME=Drone Fleet
DJI_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
DJI_WORKSPACE_NAME=Demo Workspace

# Create the first developer account interactively with `pnpm --filter @dji/api admin`
# before starting the API. Developers create Admins; Admins create Sub-admins and Pilots.

# ---- branding (optional; defaults shown) ----
# BRAND_NAME=Drone Fleet
# BRAND_SUBTITLE=Drone Command Center
# BRAND_COMPANY=Your Company
# BRAND_TAGLINE=Live video and telemetry for your fleet
# BRAND_PRIMARY_COLOR=#0a58b8
# BRAND_ACCENT_COLOR=#f2b300
# BRAND_FILE_PREFIX=DRONE-FLEET
# BRAND_LOGO_PATH=

# ---- media ----
MEDIA_RTMP_HOST=localhost:1935
# The API's WHEP proxy. Host mode: MediaMTX on loopback (started by pnpm dev).
# Docker dev: http://srs:1985/rtc/v1/whep/?app=live&stream={key}
# The browser never sees this URL or the stream key.
MEDIA_WHEP_INTERNAL_TEMPLATE=http://127.0.0.1:8889/live/{key}/whep

# ---- streams ----
# Keep a stream alive briefly after its last viewer leaves.
STREAM_LINGER_SECONDS=60
# Failed start after this long without a publish.
STREAM_START_DEADLINE_SECONDS=60
# How long to wait for the controller's live_start_push reply.
STREAM_REPLY_TIMEOUT_MS=30000

# ---- people counting ----
# The YOLOX model is installed by pnpm models:fetch (run.sh does it once, about 217 MB).
# PEOPLE_MODEL_PATH=.data/models/yolox_l.onnx
# Detections at or above the count score are counted; those between the minimum and the
# count score are shown as possible people for the operator to accept.
# Two stages: the small model answers in about two seconds, the large one refines it.
# PEOPLE_QUICK_MODEL_PATH=.data/models/yolox_s.onnx
PEOPLE_MIN_SCORE_PERCENT=20
PEOPLE_COUNT_SCORE_PERCENT=30
PEOPLE_QUICK_COUNT_SCORE_PERCENT=50
# PEOPLE_AUTO_COUNT=0 turns off counting at capture time.
# PEOPLE_THREADS defaults to every CPU core.

# ---- simulator ----
# 1 starts the simulated aircraft with the dev stack; 0 runs the stack with real hardware only.
SIM_ENABLED=1
SIM_DRONES=3
SIM_VIDEO=1
SIM_RATE_MS=1000
SIM_ORIGIN_LAT=23.8103
SIM_ORIGIN_LON=90.4125
