# Copy to infra/.env.production and fill in. Used by compose and by the API container.
# Never commit the real file.

APP_DOMAIN=app.example.com
# Optional: other names that serve the same site, space separated (an old address kept working after a move). The
# certificate must cover them too. Leave empty for none.
APP_DOMAIN_ALIASES=
# Public IPv4 of the VM; advertised as the WebRTC ICE candidate.
PUBLIC_IP=203.0.113.10
CERT_DIR=./certs

POSTGRES_USER=dji
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dji

JWT_SECRET=change-me-to-32-random-bytes
# Erlang distribution cookie for the single-node EMQX broker.
EMQX_NODE_COOKIE=change-me-emqx-cookie
PUBLIC_HOST=app.example.com
# Host directory Nginx serves /.well-known/acme-challenge/ from (certbot --webroot).
# ACME_WEBROOT=/var/www/certbot
APP_TIME_ZONE=Asia/Dhaka

# Branding: what this installation calls itself and how it looks. One image serves every
# customer; change these and restart the api container (no rebuild). See docs/on-premise.md.
BRAND_NAME=Drone Fleet
BRAND_SUBTITLE=Drone Command Center
BRAND_COMPANY=Your Company
BRAND_TAGLINE=Live video and telemetry for your fleet
# Two-step sign-in: besides the password, a 6-digit code from Google Authenticator or any authenticator app (works with
# no internet). Anyone but a Pilot may switch it on for their own account (Account screen). List here the roles that MUST
# have it, comma-separated from developer, admin, subadmin: until they set it up they can open nothing else. Empty keeps
# it optional for everyone. A Pilot signs in on a controller, where no code can be typed, so it is never required.
MFA_REQUIRED_ROLES=
# Seals each account's authenticator secret in the database, so a copy of the database alone yields no codes. Empty
# derives the key from JWT_SECRET. Set your own (32+ random characters) to keep the secrets readable if JWT_SECRET is
# ever rotated; changing it later means everyone sets two-step sign-in up again.
# TOTP_ENCRYPTION_KEY=
# Main colour (buttons, links) and accent (active menu, selected aircraft), as #rrggbb.
BRAND_PRIMARY_COLOR=#0a58b8
BRAND_ACCENT_COLOR=#f2b300
# Start of screenshot and recording file names. Defaults to the name in capitals.
# BRAND_FILE_PREFIX=DRONE-FLEET
# A square logo (PNG, JPEG, WebP or SVG, at most 2 MB) put in infra/branding/. Empty keeps
# the built-in mark.
# BRAND_LOGO_PATH=/data/branding/logo.png

DJI_APP_ID=
DJI_APP_KEY=
DJI_APP_LICENSE=
# The name Pilot 2 shows for this platform; defaults to BRAND_NAME.
# DJI_PLATFORM_NAME=Drone Fleet
DJI_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
DJI_WORKSPACE_NAME=Operations

# What Pilot 2 is told to connect to. Pilot 2 requires a scheme: ssl://host:8883
# for the TLS listener, tcp://host:1883 for plain. Without it the thing component
# fails with "connection refused" and EMQX never sees a connection attempt.
MQTT_PUBLIC_HOST=ssl://mqtt.example.com:8883
# Account the API itself uses. Controllers get their own credentials at login.
MQTT_USERNAME=dji-server
MQTT_PASSWORD=change-me-server
MQTT_CREDENTIAL_TTL_HOURS=168

MEDIA_RTMP_HOST=media.example.com:1935
# The API's WHEP proxy, internal to the compose network. Browsers never see this URL or
# the stream key; Nginx does not route /rtc/ or /live/.
MEDIA_WHEP_INTERNAL_TEMPLATE=http://srs:1985/rtc/v1/whep/?app=live&stream={key}
# Optional published media ports. Leave at the defaults on a real server; override only
# to run a smoke test beside another stack.
# SRS_RTMP_PORT=1935
# Encrypted RTMP ingest (rtmps://host:1936/live/<key>), served by Nginx with the dashboard's certificate.
# RTMPS_PORT=1936
# SRS_WEBRTC_PORT=8000

# Server recording. Video goes to the `recordings` volume (RECORDING_DIR), which is NOT in the nightly
# backup. About 2 GB an hour per drone at 4 Mbps; 12 drones recording all day is about 0.5 TB a day.
# WHERE: videos start in a Docker volume on the system disk. To keep them on a big disk or a mounted NAS, set
# STORAGE_HOST_DIR to the full path of a folder of this server on that disk (create it first; the container
# runs as root). It is mounted inside as /storage, and a Developer then chooses, in the app (Recordings, Storage
# box, Change folder), any folder inside "Server storage folder" (for example /storage/videos): everything is
# kept inside it, a folder per drone and a library/ folder for uploads. Changing the folder later never moves old
# videos; they stay where they were and keep playing.
STORAGE_HOST_DIR=/srv/drone-fleet-storage
# Record every drone from the moment it connects, as one clip that runs until the drone is switched off (or its
# stream stops), named <drone>_<serial>_auto_<date>_<time>Z.mp4. Each drone can still be switched on or off on the
# Recordings screen.
RECORDING_AUTO_DEFAULT=0
# A clip has no time limit by default (0). Set a number of seconds, 10 or more (for example 3600), to cut a long
# recording into clips of about that length: a clip only appears in the list, and only becomes playable and
# deletable by the clean-up, once it is finished.
# RECORDING_SEGMENT_SECONDS=0
# AUTOMATIC clips older than this many days are deleted; 0 keeps them until room is needed. Manual
# recordings and uploaded videos are never deleted by the clean-up.
RECORDING_RETENTION_DAYS=30
# The most the recordings may use, in GB; the oldest automatic clips go first. 0 = no limit but the floor below.
RECORDING_MAX_GB=0
# The floor: below this much free disk the oldest automatic clips are deleted, and if that is not enough
# recording pauses (and resumes by itself once there is room) so the disk never fills and stops Postgres.
RECORDING_MIN_FREE_GB=20
# RECORDING_CLEANUP_SECONDS=60
# A drone that is idle on the ground reports its position at most this often; one in the air is stored in full.
# TELEMETRY_IDLE_INTERVAL_SECONDS=30
# Delete stored telemetry, and the raw MQTT log, older than this many days. 0 (the default) keeps them: flight
# replay reads the telemetry and real aircraft captures are studied from the log.
# TELEMETRY_RETENTION_DAYS=0
# MQTT_LOG_RETENTION_DAYS=0

# Same-origin deployment: leave empty.
CORS_ORIGINS=

# Security of the sign-in. Wrong passwords in a row before an account's sign-in is locked, and for how long.
# LOGIN_MAX_FAILURES=10
# LOGIN_LOCK_MINUTES=15
# Which hops may say who the visitor is (X-Forwarded-For): Nginx on the compose network. Change only behind another
# proxy or Cloudflare, and then also teach Nginx the real visitor (set_real_ip_from).
# TRUST_PROXY=loopback,uniquelocal
# Pictures and live video handed to a customer's own program through an API token (see docs/api.md). Each live feed is one
# read of the media server, copied, not re-encoded.
# API_LIVE_MAX=8
# API_STREAM_WAIT_SECONDS=20
# Alerts about a flying aircraft itself (not zones). A battery rule set to 0 is off; ALERT_LINK_LOST=0 turns the
# contact-lost alert off. The critical percentage must be lower than the low one.
# ALERT_LINK_LOST=1
# ALERT_BATTERY_LOW_PERCENT=30
# ALERT_BATTERY_CRITICAL_PERCENT=15
# ALERT_REMAIN_CRITICAL_SECONDS=120
# The installed version (written by deploy/install.sh and deploy/upgrade.sh).
APP_VERSION=
