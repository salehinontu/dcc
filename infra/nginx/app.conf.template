# Rendered by the nginx image entrypoint; APP_DOMAIN and APP_DOMAIN_ALIASES (other names that serve the same
# site, space separated, may be empty) come from the container env. The certificate must cover every name.
# Same-origin deployment: the app, API, WebSocket and video signalling all live here.

# Sign-in requests are limited per visitor before they reach the API: each one costs a password hash, so a flood would
# otherwise tie up the server. Other requests get an empty key, which Nginx does not limit. (The API has its own,
# stricter limit and a per-account lock-out; this one protects the CPU.)
map $request_uri $signin_key {
    "~^/api/(auth/login|auth/mfa|pilot/auth)(\?|$)" $binary_remote_addr;
    default "";
}
limit_req_zone $signin_key zone=signin:10m rate=20r/m;
limit_req_status 429;

server {
    listen 80;
    server_name ${APP_DOMAIN} ${APP_DOMAIN_ALIASES};
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Container healthcheck: do not redirect this one.
    location = /healthz {
        access_log off;
        return 200 'ok';
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    # One connection carries every request of a page. The dashboard asks for a dozen things at start-up, and each
    # extra HTTP/1.1 connection costs a TLS handshake, which is slow on a long link. (Browsers fall back to
    # HTTP/1.1 by themselves for the WebSocket, so /ws is unchanged.)
    http2 on;
    server_name ${APP_DOMAIN} ${APP_DOMAIN_ALIASES};
    # The Nginx version is nobody's business.
    server_tokens off;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1h;

    include /etc/nginx/snippets/security-headers.conf;

    client_max_body_size 20m;

    # The bundle is about 1.7 MB of JavaScript: sent as it is, a page takes seconds to arrive on a slow link. The web
    # image compresses each file once at build time (`gzip_static` sends that copy), and this compresses anything
    # else text-like on the fly. The API is left alone (`gzip off` below): its answers are small and per user.
    gzip on;
    gzip_static on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript text/javascript application/json image/svg+xml;

    # Docker's embedded DNS. Resolving per request lets Nginx survive an API or SRS
    # container recreation without a `docker compose restart web`.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream http://api:3000;

    root /usr/share/nginx/html;
    index index.html;

    # Pilot 2 loads /pilot and the dashboard lives at /; both are client-side routes.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html names the hashed bundle, so a browser that keeps a copy keeps showing the old
    # app after a deploy. no-cache makes it revalidate (a cheap 304) on every load; the hashed
    # files under /assets/ never change and stay cacheable. add_header in a location replaces
    # the server-level ones, so the security headers are repeated here.
    # The build id a stale tab compares itself with; it must never be served from a cache.
    location = /version.json {
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location = /index.html {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Everything the build names with a hash never changes under that name, so a browser keeps it for good and
    # asks again only for a file a new deploy has renamed. A missing one is a plain 404 (not the SPA fallback,
    # which would hand a stale tab a page of HTML as if it were a script). The map worker below has no hash.
    location ~* "^/assets/.+-[A-Za-z0-9_-]{8}\.(js|css|png|jpe?g|svg|webp|woff2?)$" {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # MapLibre loads its worker from a runtime URL, so it cannot live in the hashed asset
    # set. The web build copies it here; do not let the SPA fallback answer for a missing
    # worker, and send the JavaScript MIME type that module workers require.
    location ~* \.mjs$ {
        default_type application/javascript;
        try_files $uri =404;
    }

    # Video uploads: the file is the request body. It streams straight to the API instead of being
    # written to Nginx's disk first, it may be large, and a slow link can take a long time. The API
    # enforces the real limit (RECORDING_UPLOAD_MAX_BYTES, 4 GB unless changed): keep this above it.
    location = /api/recordings/upload {
        gzip off;
        client_max_body_size 8g;
        proxy_pass $api_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # X-Forwarded-For is the address Nginx saw, never what the visitor wrote: the API believes this hop (TRUST_PROXY), so a
    # forged header must not reach it. (Behind another proxy or Cloudflare, set_real_ip_from makes $remote_addr the
    # visitor again.)
    location /api/ {
        gzip off;
        limit_req zone=signin burst=20 nodelay;
        proxy_pass $api_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location /ws {
        gzip off;
        proxy_pass $api_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Video signalling and playback are proxied by the API, which holds the stream key.
    # /rtc/ and /live/ are intentionally not routed: they would expose SRS directly.

    # Never expose broker, media-server or MediaMTX callbacks to the internet.
    location /internal/ {
        return 404;
    }
}
